@startuml
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontSize 11
skinparam defaultFontName "Microsoft YaHei"

rectangle "BPR" as BPR #FFE0B2
rectangle "CLER" as CLER #FFCC80
rectangle "CV-CLER" as CVCLER #FFB74D
rectangle "ARFusion-Rec" as ARFusion #FF9800

BPR --> CLER
CLER --> CVCLER
CVCLER --> ARFusion

rectangle "CV-CLER" as Path1 #BBDEFB
rectangle "ARFusion-Rec" as Path2 #C8E6C9
rectangle "CV-CLER" as Path3 #FFCDD2

CVCLER --> Path1
ARFusion --> Path2
ARFusion --> Path3

@enduml